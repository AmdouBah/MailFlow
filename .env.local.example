# ─────────────────────────────────────────────
# MailFlow — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez
# ─────────────────────────────────────────────

# App
APP_NAME=MailFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase (Client SDK — côté browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (côté serveur — API routes)
# Générez une clé de service dans Firebase Console > Paramètres > Comptes de service
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# La clé privée doit être encodée en base64 :
# node -e "console.log(Buffer.from(require('./serviceAccount.json').private_key).toString('base64'))"
FIREBASE_ADMIN_PRIVATE_KEY_BASE64=

# Chiffrement des secrets SMTP/IA dans Firestore (32 caractères aléatoires)
ENCRYPTION_KEY=your-32-character-secret-key-here

# Auth secret pour les tokens (générez avec: openssl rand -hex 32)
NEXTAUTH_SECRET=

# URL de l'application (requis pour les liens de tracking en production)
# NEXT_PUBLIC_APP_URL=https://votre-domaine.vercel.app
